<html>
    <head>
        <title>Dashboard</title>
        <meta charset="utf-8">
        <!-- bootstrap CDN -->
        <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.2/css/bootstrap.min.css" integrity="sha384-Smlep5jCw/wG7hdkwQ/Z5nLIefveQRIY9nfy6xoR1uRYBtpZgI6339F5dgvm/e9B" crossorigin="anonymous">
        <!-- font awesome CDN-->
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.3/css/all.css" integrity="sha384-UHRtZLI+pbxtHCWp1t77Bi1L4ZtiqrqD80Kn4Z8NTSRyMA2Fd33n5dQ8lWUE00s/" crossorigin="anonymous">
        <style>
            select {
                width: 200px;
                height: 40px;
                cursor: pointer;
            }
            #addButton{
                padding-left: 20px;
                padding-right: 20px;
            }
            .delete_btn,.edit_btn{
                display: block;
                margin: auto;   
            }
        </style>
    </head>
    <body style="background-color: #17a2b8;">
        <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #074650;">
            <a class="navbar-brand" href="/dashboard">TimeSheet</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
              <span class="navbar-toggler-icon"></span>
            </button>
          
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
              <ul class="navbar-nav mr-auto">
                <li class="nav-item active">
                  <a class="nav-link" href="/dashboard">Home <span class="sr-only">(current)</span></a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/listview">List View</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/export">Export Data <span class="sr-only">(current)</span></a>
                </li>
                
              </ul>
              <form class="form-inline my-2 my-lg-0">
                <a href="/users/logout" class="btn btn-danger">Logout</a>
              </form>
            </div>
        </nav>
        <div class="container" >   
            <div class="d-flex justify-content-center" >
                <div class="card mt-5 ml-5 shadow-lg p-4 mb-4 " style="width: 1000px; border-radius: 15px; background-color: rgb(255, 255, 255)">
                    <!-- CARD HEADER -->
                    <div class="card-header">
                        <div class="form-inline well">
                            <div class="form-group ml-2">
                                <label for="dateOfCalendar">Select the Date :</label>
                                <input type="date" id="dateOfCalendar" class="form-control ml-2"  placeholder="">
                            </div>
                            <div class="form-group ml-2">
                                <button onclick="submitData()" type="button" id="submitBtn" class="btn btn-outline-danger ">Submit</button>
                            </div>
                        </div>
                    </div>
                    <!-- CARD BODY -->
                    <div class="card-body">
                        <div class="form-inline well mb-5">
                            <div class="form-group ml-2">
                                <div class="projectDropdown">
                                    <select name="project" id="project">
                                        <option value="0">Hollister</option>
                                        <option value="1">Camden</option>
                                        <option value="2">TMN</option>
                                        <option value="3">Metlife</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group ml-2">
                                <div class="categoryDropdown">
                                    <select name="category" id="category">
                                        <option value="0">Internal Meeting</option>
                                        <option value="1">Client Meeting</option>
                                        <option value="2">R&D</option>
                                        <option value="3">Content Creation</option>
                                        <option value="4">Content Review</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group ml-2">    
                                    <label for="time" class="sr-only">Time in Minutes</label>
                                    <input type="text" class="form-control" id="inputTime" placeholder="Time in Minutes">
                            </div>
                            <div class="form-group ml-2">    
                                <button type="button" class="btn btn-info" data-toggle="modal" data-target="#exampleModal">
                                    Remarks <i class="fas fa-comment-dots"></i>
                                </button>
                                <!-- Modal -->
                                <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                                    <div class="modal-dialog" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                        <h5 class="modal-title" id="exampleModalLabel">Enter Remarks</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="form-group">
                                                <input type="text" class="form-control" id="remarksSection" aria-describedby="remarksSection" placeholder="Enter Remarks">
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                        <button type="button" class="btn btn-primary" data-dismiss="modal">Save changes</button>
                                        </div>
                                    </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group ml-2">    
                                <button onclick="newElement()" type="button" id="addButton" class="btn btn-primary" aria-label="Add">
                                    <span aria-hidden="true">Add <i class="fas fa-plus"></i></span>
                                </button>                            
                            </div>
                        </div>
                        
                        <!-- <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p> -->
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th scope="col"  style="text-align: center">Project</th>
                                    <th scope="col"  style="text-align: center">Category</th>
                                    <th scope="col"  style="text-align: center">Time Spent</th>
                                    <th scope="col"  style="text-align: center">Remarks</th>
                                    <th scope="col"  style="text-align: center">Delete</th>
                                    <!-- <th scope="col"  style="text-align: center">Edit</th> -->
                                </tr>
                            </thead>
                            <tbody id="timesheetBody">
                                
                            </tbody>
                        </table>
                    </div>
            </div>
            </div>
        </div>

        <script>
            var userEmail = '<%= (user.email) %>';
            let trArr = [];
            //function to generate Delete button against all table entries
            function deleteIcon(){
                let td = document.createElement("td");
                let del_btn = document.createElement("BUTTON");
                let del_i = document.createElement("i");
                del_i.className = "fas fa-trash"
                del_btn.className = "btn btn-outline-danger delete_btn";
                del_btn.appendChild(del_i);
                del_btn.onclick = deletetr;
                td.appendChild(del_btn);
                return td;
            }
            function deletetr(){
                let trDel =  this.parentElement.parentElement;
                trDel.style.display = "none";
                console.log(trDel.id);
                trArr.splice(trDel.id,1);
                console.log("After deletion : ",trArr);
            }   
            //function to generate Edit button against all table entries
            function editIcon(){
                let td = document.createElement("td");
                let edit_btn = document.createElement("BUTTON");
                let edit_i = document.createElement("i");
                edit_i.className = "fas fa-pen"
                edit_btn.className = "btn btn-outline-primary edit_btn";
                edit_btn.appendChild(edit_i);
                td.appendChild(edit_btn);
                return td;
            }
            //this function is called once Add button is called
            function newElement(){
                // console.log(document.querySelector('[id="inputTime"]').value);
                let timeVal = document.querySelector('[id="inputTime"]').value;
                let numbers = /^[0-9]+$/;
                let thArray = [];
                if(!timeVal){
                    alert("Enter Valid Time");
                    return false;
                }
                else if(!timeVal.match(numbers)){
                    alert("Enter Time in Minutes");
                    return false;
                }
                else{
                    let tr = document.createElement("tr");
                    let tbody = document.getElementById("timesheetBody");
                    let projectValue = document.getElementById("project");
                    thArray.push(projectValue.options[projectValue.selectedIndex].text);
                    let categoryValue = document.getElementById("category");
                    thArray.push(categoryValue.options[categoryValue.selectedIndex].text);
                    thArray.push(timeVal);
                    if(document.querySelector('[id="remarksSection"]').value){
                        thArray.push(document.querySelector('[id="remarksSection"]').value);
                    }
                    else{
                        thArray.push("N/A");
                        // console.log("No remarks added");
                    }
                    for(let i=0;i<thArray.length;i++){
                        let td = document.createElement("td");
                        var text = document.createTextNode(thArray[i]);
                        td.appendChild(text);
                        tr.appendChild(td);
                    }
                    trArr.push(thArray); // add thArray into tdArray to keep a list of all arrays 

                    let del = deleteIcon();
                    // let edit = editIcon();
                    tr.appendChild(del);
                    // tr.appendChild(edit);
                    tr.id = trArr.indexOf(thArray);
                    tr.className = "data";

                    tbody.appendChild(tr);
                    document.querySelector('[id="inputTime"]').value = "";
                    document.querySelector('[id="remarksSection"]').value = "";
                    console.log(trArr);
                }
            }

            function submitData(){
                var dateValue = document.getElementById("dateOfCalendar").value;
                let listLength = document.querySelectorAll('[class="data"]:not([style="display: none;"])').length;
                if(dateValue=="" || dateValue==null){
                    alert("Enter Date before Submitting");
                }
                else if (listLength<=0){
                    alert("Add Time Data before Submitting");
                }
                else{
                    // console.log("Date has been entered");
                    fetch('/timeSheetData', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            user: {
                                userEmail: userEmail,
                                dateValue: dateValue,
                                timeData: trArr,
                            }
                        })
                    });
                    trArr=[];
                    document.getElementById("dateOfCalendar").value = "";
                    let dataTobeHidden  =  document.querySelectorAll('[class="data"]');
                    for(let i=0;i<dataTobeHidden.length;i++){
                        dataTobeHidden[i].style.display = "none";
                    }
                }
            }

        </script>
        
        <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js" integrity="sha384-9/reFTGAW83EW2RDu2S0VKaIzap3H66lZH81PoYlFhbGU+6BZp6G7niu735Sk7lN" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/js/bootstrap.min.js" integrity="sha384-w1Q4orYjBQndcko6MimVbzY0tgp4pWB4lZ7lr30WKz0vr/aWKhXdBNmNb5D92v7s" crossorigin="anonymous"></script>
    
    </body>
</html>