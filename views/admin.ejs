<html>
    <head>
        <title>Admin Console</title>
        <meta charset="utf-8">
        <!-- bootstrap CDN -->
        <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.2/css/bootstrap.min.css" integrity="sha384-Smlep5jCw/wG7hdkwQ/Z5nLIefveQRIY9nfy6xoR1uRYBtpZgI6339F5dgvm/e9B" crossorigin="anonymous">
        <!-- font awesome CDN-->
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.3/css/all.css" integrity="sha384-UHRtZLI+pbxtHCWp1t77Bi1L4ZtiqrqD80Kn4Z8NTSRyMA2Fd33n5dQ8lWUE00s/" crossorigin="anonymous">
        <style>
            select {
                width: 200px;
                height: 40px;
                cursor: pointer;
            }
            #addButton{
                padding-left: 20px;
                padding-right: 20px;
            }
            .delete_btn,.edit_btn{
                display: block;
                margin: auto;   
            }
        </style>
    </head>
    <body style="background-color: #17a2b8;">
        <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #074650;">
            <a class="navbar-brand" href="/dashboard">TimeSheet</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
              <span class="navbar-toggler-icon"></span>
            </button>
          
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
              <ul class="navbar-nav mr-auto">
                <li class="nav-item">
                  <a class="nav-link" href="/dashboard">Home</a>
                </li>
                <li class="nav-item active">
                    <a class="nav-link" href="/admin">Admin Console <span class="sr-only">(current)</span></a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/listview">List View</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/export">Export Data</a>
                </li>
              </ul>
              <form class="form-inline my-2 my-lg-0">
                <button type="button" onclick="submitData()" id="submit" class="btn btn-danger ml-2">
                    Submit                                      
                </button>

                <a href="/users/logout" class="btn btn-outline-light ml-4">Logout</a>
              </form>
            </div>
        </nav>
        <div class="container" >   
            <div class="d-flex justify-content-center" >
                <div class="card mt-5 ml-5 shadow-lg p-4 mb-4 " style="width: 1000px; border-radius: 15px; background-color: rgb(255, 255, 255)">
                    <div class="accordion" id="AdminAccordion">
                        <div class="card">
                            <div class="card-header" id="adminHeader">
                              <h2 class="mb-0">
                                <div class="form-inline well">
                                    <button class="btn btn-secondary" type="button" data-toggle="collapse" data-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                                        Admins
                                    </button>
                                    <div class="form-group" data-toggle="tooltip" data-placement="top" title="Search for Admin">
                                        <input style="width:300px; height: 35px; margin-left: 20px;" type="text" id="searchEmail" placeholder="Email" class="form-control">
                                    </div>  
                                    <div class="form-group">
                                        <button type="button" onclick="searchAdmin()" id="searchAdmin" class="btn btn-info ml-2">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                    <div class="form-group" data-toggle="tooltip" data-placement="top" title="Add Admin">
                                        <input style="width:300px; height: 35px; margin-left: 50px;" type="email" id="emailEmp" placeholder="Email" class="form-control">
                                    </div>  
                                    <div class="form-group">
                                        <button type="button" onclick="addAdmin()" id="addAdmin" class="btn btn-info ml-2">
                                            <i class="fas fa-plus"></i>                                        
                                        </button>
                                    </div>
                                </div>
                              </h2>
                            </div>
                            <div id="collapseOne" class="collapse show" aria-labelledby="adminHeader" data-parent="#AdminAccordion">
                              <div class="card-body" id="adminBody">
                                <table class="table table-bordered" id="adminTable">
                                    <tr>
                                        <th scope="col"  style="text-align: center">Email</th>
                                        <th scope="col"  style="text-align: center; width: 150px;">Delete</th>
                                    </tr>
                                </table>
                              </div>
                            </div>
                          </div>
                        <div class="card">
                          <div class="card-header" id="projectHeader">
                            <h2 class="mb-0">
                                <div class="form-inline well">
                                    <button class="btn btn-secondary collapsed" type="button" data-toggle="collapse" data-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                        Projects
                                    </button>
                                    <div class="form-group" data-toggle="tooltip" data-placement="top" title="Search for Project">
                                        <input style="width:300px; height: 35px; margin-left: 20px;" type="text" id="searchProject" placeholder="Project" class="form-control">
                                    </div>  
                                    <div class="form-group">
                                        <button type="button" onclick="searchProject()" id="searchProject" class="btn btn-info ml-2">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                    <div class="form-group" data-toggle="tooltip" data-placement="top" title="Add Project">
                                        <input style="width:300px; height: 35px; margin-left: 50px;" type="text" id="projectInput" placeholder="Project" class="form-control">
                                    </div>  
                                    <div class="form-group">
                                        <button type="button" onclick="addProject()" id="addProject" class="btn btn-info ml-2">
                                            <i class="fas fa-plus"></i>                                        
                                        </button>
                                    </div>
                                </div>
                            </h2>
                          </div>
                          <div id="collapseTwo" class="collapse" aria-labelledby="projectHeader" data-parent="#AdminAccordion">
                            <div class="card-body" id="projectBody">
                                <table class="table table-bordered" id="projectTable">
                                    <tr>
                                        <th scope="col"  style="text-align: center">Project</th>
                                        <th scope="col"  style="text-align: center; width: 150px;">Delete</th>
                                    </tr>
                                </table>                            
                            </div>
                          </div>
                        </div>
                        <div class="card">
                          <div class="card-header" id="categoryHeader">
                            <h2 class="mb-0">
                                <div class="form-inline well">
                                    <button class="btn btn-secondary collapsed" type="button" data-toggle="collapse" data-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                        Category
                                    </button>
                                    <div class="form-group" data-toggle="tooltip" data-placement="top" title="Search for Category">
                                        <input style="width:300px; height: 35px; margin-left: 20px;" type="text" id="searchCategory" placeholder="Category" class="form-control">
                                    </div>  
                                    <div class="form-group">
                                        <button type="button" onclick="searchCategory()" id="searchCategory" class="btn btn-info ml-2">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                    <div class="form-group" data-toggle="tooltip" data-placement="top" title="Add Category">
                                        <input style="width:300px; height: 35px; margin-left: 50px;" type="text" id="categoryInput" placeholder="Category" class="form-control">
                                    </div>  
                                    <div class="form-group">
                                        <button type="button" onclick="addCategory()" id="addCategory" class="btn btn-info ml-2">
                                            <i class="fas fa-plus"></i>                                        
                                        </button>
                                    </div>
                                </div>
                            </h2>
                          </div>
                          <div id="collapseThree" class="collapse" aria-labelledby="categoryHeader" data-parent="#AdminAccordion">
                            <div class="card-body" id="categoryBody">
                                <table class="table table-bordered" id="categoryTable">
                                    <tr>
                                        <th scope="col"  style="text-align: center">Category</th>
                                        <th scope="col"  style="text-align: center; width: 150px;">Delete</th>
                                    </tr>
                                </table>  
                            </div>
                          </div>
                        </div>
                      </div>                 
            </div>
            </div>
        </div>

        <script>
            var emailList =<%-JSON.stringify(emailList)%>;
            var projectList =<%-JSON.stringify(projectList)%>;
            var categoryList =<%-JSON.stringify(categoryList)%>;

            //function called when the document loads for the first time 
            function initWindow(){
                document.getElementById("searchEmail").value = "";
                document.getElementById("emailEmp").value = "";
                
                document.getElementById("searchProject").value = "";
                document.getElementById("projectInput").value = "";

                document.getElementById("searchCategory").value = "";
                document.getElementById("categoryInput").value = "";

                for(let i=0;i<emailList.length;i++){
                    createAdminTable(emailList[i]);
                }
                for(let i=0;i<projectList.length;i++){
                    createProjectTable(projectList[i]);
                }
                for(let i=0;i<categoryList.length;i++){
                    createCategoryTable(categoryList[i]);
                }

            }

            //function called when the document loads for the first time 
            document.onload = initWindow();

            //function to create Category Table ---------------------------------------------------------------------------
            function createCategoryTable(value){
                let tr = document.createElement("tr");
                let adminTable = document.getElementById("categoryTable");

                let td = document.createElement("td");
                td.style = "text-align: center";
                td.className = "category";
                
                let text = document.createTextNode(value);
                td.appendChild(text);
                tr.appendChild(td);

                let del = deleteCategoryIcon();
                tr.appendChild(del);

                adminTable.appendChild(tr);
            }

            function deleteCategoryIcon(){
                let td = document.createElement("td");
                let del_btn = document.createElement("BUTTON");
                let del_i = document.createElement("i");
                del_i.className = "fas fa-trash"
                del_btn.className = "btn btn-outline-danger delete_btn";
                del_btn.appendChild(del_i);
                del_btn.onclick = deleteCategory;
                td.appendChild(del_btn);
                return td;
            }

            function deleteCategory(){
                console.log("Delete Category is clicked");
                let trDel =  this.parentElement.parentElement;
                let trdelcategory = trDel.childNodes[0].innerHTML;
                const indexCategory = categoryList.indexOf(trdelcategory);
                categoryList.splice(indexCategory,1);
                console.log(categoryList);
                trDel.removeChild(trDel.childNodes[0]);
                trDel.removeChild(trDel.childNodes[0]);   
            }

            function searchCategory(){
                let searchCategory = document.getElementById("searchCategory").value.toUpperCase();
                let searchClass = document.querySelectorAll('[class="category"]');
                for(let i=0;i<searchClass.length;i++){
                    if(searchCategory)
                    {
                        if(searchClass[i].innerHTML.toUpperCase().indexOf(searchCategory)==-1){
                            searchClass[i].parentElement.style.display = "none";
                        }
                        else{
                            searchClass[i].parentElement.style.display = "";
                        }
                    }
                    else{
                        searchClass[i].parentElement.style.display = "";
                    }
                }
            }
            
            //function to add Category to the list of Categories
            function addCategory(){
                let category = document.getElementById("categoryInput").value;
                if(category){
                    if(categoryList.indexOf(category)!=-1){  //project already present
                        alert("Category present in list of Categories");
                        document.getElementById("categoryInput").value = "";
                        return;
                    }
                    else{
                        categoryList.push(category);
                        createCategoryTable(category);
                    }
                }else{
                    alert("Enter the correct category");
                }
                document.getElementById("categoryInput").value = "";
            }
            
            //function to create Project Table ---------------------------------------------------------------------------
            function createProjectTable(value){
                let tr = document.createElement("tr");
                let adminTable = document.getElementById("projectTable");

                let td = document.createElement("td");
                td.style = "text-align: center";
                td.className = "project";
                
                let text = document.createTextNode(value);
                td.appendChild(text);
                tr.appendChild(td);

                let del = deleteProjectIcon();
                tr.appendChild(del);

                adminTable.appendChild(tr);
            }

            // function to add delete Icon for every project added into the table
            function deleteProjectIcon(){
                let td = document.createElement("td");
                let del_btn = document.createElement("BUTTON");
                let del_i = document.createElement("i");
                del_i.className = "fas fa-trash"
                del_btn.className = "btn btn-outline-danger delete_btn";
                del_btn.appendChild(del_i);
                del_btn.onclick = deleteProject;
                td.appendChild(del_btn);
                return td;
            }

            //function to delete the project and remove from the array
            function deleteProject(){
                console.log("Delete project is clicked");
                let trDel =  this.parentElement.parentElement;
                let trdelproject = trDel.childNodes[0].innerHTML;
                const indexProject = projectList.indexOf(trdelproject);
                projectList.splice(indexProject,1);
                console.log(projectList);
                trDel.removeChild(trDel.childNodes[0]);
                trDel.removeChild(trDel.childNodes[0]);            
            }

            //function to search project in the list of projects
            function searchProject(){
                let searchProject = document.getElementById("searchProject").value.toUpperCase();
                let searchClass = document.querySelectorAll('[class="project"]');
                for(let i=0;i<searchClass.length;i++){
                    if(searchProject)
                    {
                        if(searchClass[i].innerHTML.toUpperCase().indexOf(searchProject)==-1){
                            searchClass[i].parentElement.style.display = "none";
                        }
                        else{
                            searchClass[i].parentElement.style.display = "";
                        }
                    }
                    else{
                        searchClass[i].parentElement.style.display = "";
                    }
                }
            }

            //function to add Project to the list of admins
            function addProject(){
                let project = document.getElementById("projectInput").value;
                if(project){
                    if(projectList.indexOf(project)!=-1){  //project already present
                        alert("Project present in list of Project");
                        document.getElementById("projectInput").value = "";
                        return;
                    }
                    else{
                        projectList.push(project);
                        createProjectTable(project);
                    }
                }else{
                    alert("Enter the correct category");
                }
                document.getElementById("projectInput").value = "";
            }

            //function to create the table ----------------------------------------------------------------------------------
            function createAdminTable(value){
                let tr = document.createElement("tr");
                let adminTable = document.getElementById("adminTable");

                let td = document.createElement("td");
                td.style = "text-align: center";
                td.className = "adminEmail";
                
                let text = document.createTextNode(value);
                td.appendChild(text);
                tr.appendChild(td);

                let del = deleteAdminIcon();
                tr.appendChild(del);

                adminTable.appendChild(tr);
            }

            //function to delete the admin and remove from the array
            function deleteAdmin(){
                console.log("Delete Admin is clicked");
                let trDel =  this.parentElement.parentElement;
                let trdelemail = trDel.childNodes[0].innerHTML;
                const indexEmail = emailList.indexOf(trdelemail);
                emailList.splice(indexEmail,1);
                console.log(emailList);
                trDel.removeChild(trDel.childNodes[0]);
                trDel.removeChild(trDel.childNodes[0]);
            }

            // function to add delete Icon for every admin added into the table
            function deleteAdminIcon(){
                let td = document.createElement("td");
                let del_btn = document.createElement("BUTTON");
                let del_i = document.createElement("i");
                del_i.className = "fas fa-trash"
                del_btn.className = "btn btn-outline-danger delete_btn";
                del_btn.appendChild(del_i);
                del_btn.onclick = deleteAdmin;
                td.appendChild(del_btn);
                return td;
            }

            //function to search admins in the list of admins
            function searchAdmin(){
                let searchEmail = document.getElementById("searchEmail").value.toUpperCase();
                let searchClass = document.querySelectorAll('[class="adminEmail"]');
                for(let i=0;i<searchClass.length;i++){
                    if(searchEmail)
                    {
                        if(searchClass[i].innerHTML.toUpperCase().indexOf(searchEmail)==-1){
                            searchClass[i].parentElement.style.display = "none";
                        }
                        else{
                            searchClass[i].parentElement.style.display = "";
                        }
                    }
                    else{
                        searchClass[i].parentElement.style.display = "";
                    }
                }
            }

            //function to validate the email entered for adding admins
            function ValidateEmail(mail) 
            {
                console.log(mail);
                if (/^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$/.test(mail))
                {
                    return (true)
                }
                return (false)
            }
            
            //function to add Admin to the list of admins
            function addAdmin(){
                let email = document.getElementById("emailEmp").value;
                let validatedEmail = ValidateEmail(email);
                if(validatedEmail){
                    if(emailList.indexOf(email)!=-1){  //email already present
                        alert("Email present in list of admins");
                        document.getElementById("emailEmp").value = "";

                        return;
                    }
                    else{
                        emailList.push(email);
                        createAdminTable(email);
                    }
                }else{
                    alert("Enter the correct email");
                }
                document.getElementById("emailEmp").value = "";
            }
            
            //function to post data on click of submit button
            function submitData(){
                fetch('/adminpost', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        adminList:emailList,
                        projectList:projectList,
                        categoryList:categoryList
                    })
                });
            }

        </script>
        
        <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js" integrity="sha384-9/reFTGAW83EW2RDu2S0VKaIzap3H66lZH81PoYlFhbGU+6BZp6G7niu735Sk7lN" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/js/bootstrap.min.js" integrity="sha384-w1Q4orYjBQndcko6MimVbzY0tgp4pWB4lZ7lr30WKz0vr/aWKhXdBNmNb5D92v7s" crossorigin="anonymous"></script>
    
    </body>
</html>