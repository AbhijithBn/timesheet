<html>
    <head>
        <title>Dashboard</title>
        <meta charset="utf-8">
        <!-- bootstrap CDN -->
        <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.2/css/bootstrap.min.css" integrity="sha384-Smlep5jCw/wG7hdkwQ/Z5nLIefveQRIY9nfy6xoR1uRYBtpZgI6339F5dgvm/e9B" crossorigin="anonymous">
        <!-- font awesome CDN-->
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.3/css/all.css" integrity="sha384-UHRtZLI+pbxtHCWp1t77Bi1L4ZtiqrqD80Kn4Z8NTSRyMA2Fd33n5dQ8lWUE00s/" crossorigin="anonymous">
        
    </head>
    <body style="background-color: #17a2b8;">
        <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #074650;">
            <a class="navbar-brand" href="/dashboard">TimeSheet</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
              <span class="navbar-toggler-icon"></span>
            </button>
          
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
              <ul class="navbar-nav mr-auto">
                <li class="nav-item">
                  <a class="nav-link" href="/dashboard">Home</span></a>
                </li>
                <li class="nav-item active">
                  <a class="nav-link" href="">List View <span class="sr-only">(current)</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/export">Export Data <span class="sr-only">(current)</span></a>
                </li>
              </ul>
              <form class="form-inline my-2 my-lg-0">
                <a href="/users/logout" class="btn btn-danger">Logout</a>
              </form>
            </div>
        </nav>
        <div class="container" >   
            <div class="d-flex justify-content-center" >
                <div class="card mt-5 ml-5 shadow-lg p-4 mb-4 " style="width: 1000px; border-radius: 15px; background-color: rgb(255, 255, 255)">
                    <div id="accordion">
                        <div class="card">
                            <div class="card-header" id="headingOne" style="display: none;">
                                <h5 class="mb-0">
                                    <button class="btn btn-primary">
                                    Collapsible Group Item #1
                                    </button>
                                </h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script type="text/javascript">
            let newTimeArr = <%- JSON.stringify(newTimeArr) %>;
            let newDataArr = <%- JSON.stringify(newDataArr) %>;
            for(let i=0;i<newTimeArr.length;i++){
                //card
                let card = document.createElement("div");
                card.className = "card";

                //card Header
                let cardHeader = document.createElement("div");
                cardHeader.className = "card-header";
                cardHeader.id = "heading"+String(newTimeArr[i]);

                //h5
                let h5 = document.createElement("h5");
                h5.className = "mb-0";

                //button in header to collapse the card
                let collapseButton = document.createElement("h5");
                collapseButton.className = "btn btn-link collapsed";
                collapseButton.setAttribute("data-toggle","collapse");
                collapseButton.setAttribute("data-target","#collapse"+String(newTimeArr[i]));
                collapseButton.setAttribute("aria-expanded","false");
                collapseButton.setAttribute("aria-controls","collapse"+String(newTimeArr[i]));
                collapseButton.innerText = reverseString(newTimeArr[i]);
                
                //collapseDiv
                let collapseDiv = document.createElement("div");
                collapseDiv.id = "collapse"+String(newTimeArr[i]);
                collapseDiv.className = "collapse";
                collapseDiv.setAttribute("aria-labelledby","heading"+String(newTimeArr[i]));
                collapseDiv.setAttribute("data-parent","#accordion");

                //card body
                let cardBody = document.createElement("div");
                cardBody.className = "card-body";
                // cardBody.innerText = "something";
                let table = createTable(newDataArr[i]);
                cardBody.appendChild(table);

                //create the card Body
                collapseDiv.appendChild(cardBody);

                //create Card header
                h5.appendChild(collapseButton);
                cardHeader.appendChild(h5);
                card.appendChild(cardHeader);
                card.appendChild(collapseDiv)

                document.getElementById("accordion").appendChild(card);
            }

            function reverseString(string){
                let splitArray = string.split("-");
                let reverseArray = splitArray.reverse();
                let joinArray = reverseArray.join("-");
                return joinArray;
            }

            function createTable(array){
                //create table
                let table = document.createElement("table");
                table.className = "table table-bordered";

                //create thead
                let thead = document.createElement("thead");

                //create th
                for(let j=0;j<4;j++){
                    let th = document.createElement("th");
                    th.style = "text-align: center"
                    th.setAttribute("scope","col");
                    switch(j) {
                        case 0:
                            th.innerText = "Project";
                            break;
                        case 1:
                            th.innerText = "Category";
                            // code block
                            break;
                        case 2:
                            th.innerText = "Time Spend";
                            // code block
                            break;
                        case 3:
                            th.innerText = "Remarks";
                            // code block
                            break;
                        default:
                            // code block
                            console.log(j);
                    } 
                    thead.appendChild(th);
                }

                table.appendChild(thead);

                //create tbody
                let tbody =  document.createElement("tbody");
                tbody.id = "timesheetBody";

                for(let i=0;i<array.length;i++){
                    let tr = document.createElement("tr");
                    for(let j=0;j<4;j++){
                        let td = document.createElement("td");
                        let text = document.createTextNode(array[i][j]);
                        td.appendChild(text);
                        tr.appendChild(td);
                    }
                    tbody.appendChild(tr);
                }
                table.appendChild(tbody);
                return table;
            }
            
            
        </script>

        
        
        <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js" integrity="sha384-9/reFTGAW83EW2RDu2S0VKaIzap3H66lZH81PoYlFhbGU+6BZp6G7niu735Sk7lN" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/js/bootstrap.min.js" integrity="sha384-w1Q4orYjBQndcko6MimVbzY0tgp4pWB4lZ7lr30WKz0vr/aWKhXdBNmNb5D92v7s" crossorigin="anonymous"></script>
    
    </body>
</html>